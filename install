#!/usr/bin/env bash
# Link the user-level agent configuration in user/ to where each coding agent
# reads it. See README.md and docs/harnesses.md.
#
# Usage: install [--harness claude|codex|opencode|pi]...
#
# With no --harness, it sets up all four. It never removes or replaces anything
# that it did not write: when something is not as expected, it reports it, goes
# on with the rest, and exits with status 1. Keep it compatible with bash 3.2
# (macOS /bin/bash).

set -euo pipefail
shopt -s nullglob
shopt -u dotglob

HOUSE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
USER_DIR="$HOUSE/user"
ALL_HARNESSES="claude codex opencode pi"
# Codex, OpenCode and Pi read the skills here; Claude Code reads them in its own
# directory (docs/harnesses.md).
SHARED_SKILLS_DIR="$HOME/.agents/skills"
GENERATED_PREFIX="# Generated by agent-house install from "

problems=0

usage() {
    echo "usage: $0 [--harness ${ALL_HARNESSES// /|}]..." >&2
    exit 2
}

report() {
    echo "agent-house install: $*" >&2
    problems=$((problems + 1))
}

is_harness() {
    local harness
    for harness in $ALL_HARNESSES; do
        [[ "$1" == "$harness" ]] && return 0
    done
    return 1
}

# The directory where a harness reads its user-level configuration. Each one
# honours that harness's own override variable.
harness_dir() {
    case "$1" in
        claude) echo "${CLAUDE_CONFIG_DIR:-$HOME/.claude}" ;;
        codex) echo "${CODEX_HOME:-$HOME/.codex}" ;;
        opencode) echo "${XDG_CONFIG_HOME:-$HOME/.config}/opencode" ;;
        pi) echo "${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}" ;;
    esac
}

# The name under which a harness reads user/AGENTS.md. Claude Code reads its
# user-level instructions only from CLAUDE.md (docs/harnesses.md).
instructions_name() {
    case "$1" in
        claude) echo "CLAUDE.md" ;;
        *) echo "AGENTS.md" ;;
    esac
}

# A directory that install writes into must be a directory of its own, not a
# link. Its parents can be links. Returns 1, after a report, when the
# directory cannot be used: then the caller skips what it would put there.
make_dir() {
    local dir="$1"
    if [[ -L "$dir" ]]; then
        report "$dir: is a link; expected a directory of its own"
        return 1
    elif [[ -e "$dir" && ! -d "$dir" ]]; then
        report "$dir: exists and is not a directory"
        return 1
    elif ! mkdir -p "$dir"; then
        report "$dir: could not make it"
        return 1
    fi
}

make_link() {
    local source="$1"
    local target="$2"
    if [[ -L "$target" ]]; then
        if [[ "$(readlink "$target")" != "$source" ]]; then
            report "$target: links to $(readlink "$target"); expected $source"
        fi
    elif [[ -e "$target" ]]; then
        report "$target: exists and is not a link to $source"
    elif ln -s "$source" "$target"; then
        echo "linked $target -> $source"
    else
        report "$target: could not link it to $source"
    fi
}

# Write a file so that a failed write leaves the old file as it was: write a
# temporary file beside it, then rename it.
write_file() {
    local target="$1"
    local content="$2"
    local temporary
    if ! temporary="$(mktemp "$(dirname "$target")/.agent-house.XXXXXX")"; then
        report "$target: could not write it"
        return 1
    fi
    # mktemp makes the file 0600. "=rw" with no u, g or o applies the umask,
    # as a plain write would; "a=rw" would not.
    if printf '%s\n' "$content" >"$temporary" &&
        chmod =rw "$temporary" &&
        mv -f "$temporary" "$target"; then
        return 0
    fi
    rm -f "$temporary"
    report "$target: could not write it; the old file is as it was"
    return 1
}

# Report each dangling link in the directory $1, hidden ones too. With a second
# argument, also report each link to one of our skills: in a harness's own
# skills directory, that is the layout before skills moved to
# SHARED_SKILLS_DIR, and the harness can then see a skill twice.
check_links() {
    local dir="$1"
    local old_skills="${2:-}"
    local entry target
    [[ -d "$dir" ]] || return 0
    if [[ ! -r "$dir" || ! -x "$dir" ]]; then
        report "$dir: could not read it, so its links were not checked"
        return 0
    fi
    for entry in "$dir"/* "$dir"/.*; do
        case "${entry##*/}" in
            . | ..) continue ;;
        esac
        [[ -L "$entry" ]] || continue
        target="$(readlink "$entry")"
        [[ -e "$entry" ]] || report "$entry: dangling link to $target"
        if [[ -n "$old_skills" && "$target" == "$USER_DIR/skills/"* ]]; then
            report "$entry: links to a skill here, but skills now go in $SHARED_SKILLS_DIR"
        fi
    done
}

link_skills() {
    local dir="$1"
    local skill
    make_dir "$dir" || return 0
    for skill in "$USER_DIR"/skills/*; do
        [[ "$skill" == *~ ]] && continue
        if [[ ! -f "$skill/SKILL.md" ]]; then
            report "$skill: not a skill directory (no SKILL.md)"
            continue
        fi
        make_link "$skill" "$dir/${skill##*/}"
    done
}

link_agents() {
    local dir="$1/agents"
    local agent
    make_dir "$dir" || return 0
    for agent in "$USER_DIR"/agents/*; do
        [[ "$agent" == *~ ]] && continue
        if [[ "$agent" != *.md ]]; then
            report "$agent: not a subagent file (*.md)"
            continue
        fi
        make_link "$agent" "$dir/${agent##*/}"
    done
}

# The generated-file comment in the first two lines of a file, if any. Only a
# regular file can be one that install generated, so only one is read.
generated_marker() {
    [[ -f "$1" && ! -L "$1" ]] || return 0
    head -n 2 "$1" | grep -F -- "$GENERATED_PREFIX" | head -n 1 || true
}

# Codex and OpenCode cannot read Claude Code's subagent format, so install
# writes their subagents from user/agents/ with tools/convert-agent.py. A
# comment in the first two lines says the file was generated, and from what.
generate_agents() {
    local dir="$1/agents"
    local format="$2"
    local extension="$3"
    local agent name target header content existing
    make_dir "$dir" || return 0
    if ! command -v python3 >/dev/null; then
        report "python3 not found; it is needed to write the $format subagents"
        return 0
    fi
    for agent in "$USER_DIR"/agents/*.md; do
        name="${agent##*/}"
        target="$dir/${name%.md}.$extension"
        header="${GENERATED_PREFIX}${agent}. Do not edit it: edit the source and run install again."
        if [[ (-e "$target" || -L "$target") && "$(generated_marker "$target")" != "$header" ]]; then
            report "$target: exists and was not generated from $agent"
            continue
        fi
        if ! content="$(python3 "$HOUSE/tools/convert-agent.py" "$format" "$agent" "$header")"; then
            report "$agent: could not convert it for $format"
            continue
        fi
        existing=""
        if [[ -e "$target" ]] && ! existing="$(cat "$target")"; then
            report "$target: could not read it"
            continue
        fi
        if [[ "$content" != "$existing" ]] && write_file "$target" "$content"; then
            echo "wrote $target"
        fi
    done
    # A temporary file that a write left, when it was stopped.
    for target in "$dir"/.agent-house.*; do
        report "$target: a temporary file from an earlier run that was stopped"
    done
    # A generated file whose source is gone.
    for target in "$dir"/*."$extension"; do
        header="$(generated_marker "$target")"
        if [[ "$header" == "${GENERATED_PREFIX}${USER_DIR}/agents/"* ]]; then
            agent="${header#"$GENERATED_PREFIX"}"
            agent="${agent%%. Do not edit*}"
            [[ -e "$agent" ]] || report "$target: generated from $agent, which no longer exists"
        fi
    done
}

# Everything that goes in the harness's own directory. The shared skills do
# not: they are installed once, after the harnesses.
install_harness() {
    local harness="$1"
    local dir
    dir="$(harness_dir "$harness")"
    make_dir "$dir" || return 0

    make_link "$USER_DIR/AGENTS.md" "$dir/$(instructions_name "$harness")"
    case "$harness" in
        codex) generate_agents "$dir" codex toml ;;
        opencode) generate_agents "$dir" opencode md ;;
        *) link_agents "$dir" ;;
    esac
    if [[ "$harness" == claude ]]; then
        link_skills "$dir/skills"
        check_links "$dir/skills"
        if [[ -e "$dir/AGENTS.md" || -L "$dir/AGENTS.md" ]]; then
            report "$dir/AGENTS.md: Claude Code reads it only as a project file of an ancestor directory, so with CLAUDE.md it can load twice (docs/harnesses.md)"
        fi
    else
        check_links "$dir/skills" old-skills
    fi
    check_links "$dir"
    check_links "$dir/agents"
}

# Each name is checked to be one harness, so the list splits safely on spaces.
harnesses=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --harness)
            [[ $# -ge 2 ]] || usage
            if ! is_harness "$2"; then
                echo "unknown harness: $2" >&2
                usage
            fi
            harnesses="$harnesses $2"
            shift 2
            ;;
        *) usage ;;
    esac
done

shared_skills=""
for harness in ${harnesses:-$ALL_HARNESSES}; do
    install_harness "$harness"
    [[ "$harness" == claude ]] || shared_skills=yes
done
if [[ -n "$shared_skills" ]]; then
    link_skills "$SHARED_SKILLS_DIR"
    check_links "$SHARED_SKILLS_DIR"
fi

if [[ $problems -gt 0 ]]; then
    echo "agent-house install: $problems problem(s); nothing was removed or replaced. Look into each one, then run install again." >&2
    exit 1
fi
