#!/usr/bin/env bash
# Link the user-level agent configuration in user/ to where each coding agent
# reads it. See README.md and docs/harnesses.md.
#
# Usage: install [--harness claude|codex|opencode|pi]...
#
# With no --harness, it sets up all four. Keep it compatible with bash 3.2
# (macOS /bin/bash).

set -euo pipefail
shopt -s nullglob
shopt -u dotglob

HOUSE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
USER_DIR="$HOUSE/user"
ALL_HARNESSES="claude codex opencode pi"
# Codex, OpenCode and Pi read the skills here; Claude Code reads them in its own
# directory (docs/harnesses.md).
SHARED_SKILLS_DIR="$HOME/.agents/skills"
GENERATED_PREFIX="# Generated by agent-house install from "
GENERATED_SUFFIX=". Do not edit it: edit the source and run install again."

problems=0

usage() {
    echo "usage: $0 [--harness ${ALL_HARNESSES// /|}]..." >&2
    exit 2
}

report() {
    echo "agent-house install: $*" >&2
    problems=$((problems + 1))
}

is_harness() {
    local harness
    for harness in $ALL_HARNESSES; do
        [[ "$1" == "$harness" ]] && return 0
    done
    return 1
}

# The directory where a harness reads its user-level configuration. Each one
# honours that harness's own override variable.
harness_dir() {
    local dir
    case "$1" in
        claude) dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}" ;;
        codex) dir="${CODEX_HOME:-$HOME/.codex}" ;;
        opencode) dir="${XDG_CONFIG_HOME:-$HOME/.config}/opencode" ;;
        pi) dir="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}" ;;
    esac
    # A trailing slash hides a directory symlink from -L. Keep the root path.
    while [[ "$dir" != / && "$dir" == */ ]]; do
        dir="${dir%/}"
    done
    echo "$dir"
}

# The name under which a harness reads user/AGENTS.md. Claude Code reads its
# user-level instructions only from CLAUDE.md (docs/harnesses.md).
instructions_name() {
    case "$1" in
        claude) echo "CLAUDE.md" ;;
        *) echo "AGENTS.md" ;;
    esac
}

# Validate sources without creating them. Empty source directories are valid.
check_source_dir() {
    if [[ ! -d "$1" || ! -r "$1" || ! -x "$1" ]]; then
        report "$1: not a readable and searchable directory"
        return 1
    fi
}

check_source_file() {
    if [[ ! -f "$1" || ! -r "$1" ]]; then
        report "$1: not a readable regular file"
        return 1
    fi
}

# Make a directory that install writes into, and report its dangling links.
# It must be a directory of its own, not a link. Its parents can be links.
# Returns 1, after a report, when the directory cannot be used: then the
# caller skips what it would put there.
prepare_dir() {
    local dir="$1"
    if [[ -L "$dir" ]]; then
        report "$dir: is a link; expected a directory of its own"
        return 1
    elif [[ -e "$dir" && ! -d "$dir" ]]; then
        report "$dir: exists and is not a directory"
        return 1
    elif ! mkdir -p "$dir"; then
        report "$dir: could not make it"
        return 1
    fi
    check_links "$dir"
}

make_link() {
    local source="$1"
    local target="$2"
    if [[ -L "$target" ]]; then
        if [[ "$(readlink "$target")" != "$source" ]]; then
            report "$target: links to $(readlink "$target"); expected $source"
        fi
    elif [[ -e "$target" ]]; then
        report "$target: exists and is not a link to $source"
    elif ln -s "$source" "$target"; then
        echo "linked $target -> $source"
    else
        report "$target: could not link it to $source"
    fi
}

# Write a file so that a failed write leaves the old file as it was: write a
# temporary file beside it, then rename it.
write_file() {
    local target="$1"
    local content="$2"
    local temporary
    if ! temporary="$(mktemp "$(dirname "$target")/.agent-house.XXXXXX")"; then
        report "$target: could not write it"
        return 1
    fi
    # mktemp makes the file 0600. "=rw" with no u, g or o applies the umask,
    # as a plain write would; "a=rw" would not.
    if printf '%s\n' "$content" >"$temporary" &&
        chmod =rw "$temporary" &&
        mv -f "$temporary" "$target"; then
        return 0
    fi
    rm -f "$temporary"
    report "$target: could not write it; the old file is as it was"
    return 1
}

# Report each dangling link in the directory $1, hidden ones too. With a second
# argument, also report each link to one of our skills: in a harness's own
# skills directory, that is the layout before skills moved to
# SHARED_SKILLS_DIR, and the harness can then see a skill twice.
check_links() {
    local dir="$1"
    local old_skills="${2:-}"
    local entry target
    [[ -d "$dir" ]] || return 0
    if [[ ! -r "$dir" || ! -x "$dir" ]]; then
        report "$dir: could not read it, so its links were not checked"
        return 0
    fi
    for entry in "$dir"/* "$dir"/.*; do
        case "${entry##*/}" in
            . | ..) continue ;;
        esac
        [[ -L "$entry" ]] || continue
        target="$(readlink "$entry")"
        [[ -e "$entry" ]] || report "$entry: dangling link to $target"
        if [[ -n "$old_skills" && "$target" == "$USER_DIR/skills/"* ]]; then
            report "$entry: links to a skill here, but skills now go in $SHARED_SKILLS_DIR"
        fi
    done
}

# Link each source ($2 and on) into the directory $1, under its own name.
link_each() {
    local dir="$1"
    local source
    shift
    prepare_dir "$dir" || return 0
    for source in "$@"; do
        make_link "$source" "$dir/${source##*/}"
    done
}

# The source subagent that the generated-file comment in the first two lines
# of the file $1 names, if it has one. Only a regular file can be one that
# install generated, so only one is read. Return 1 if its header cannot be read.
generated_source() {
    local header line
    [[ -f "$1" && ! -L "$1" ]] || return 0
    header="$(head -n 2 "$1" 2>/dev/null)" || return 1
    while IFS= read -r line; do
        if [[ "$line" == "$GENERATED_PREFIX"*"$GENERATED_SUFFIX" ]]; then
            line="${line#"$GENERATED_PREFIX"}"
            echo "${line%"$GENERATED_SUFFIX"}"
            return 0
        fi
    done <<<"$header"
    return 0
}

# Link each file in the source directory $1 to the same path in the directory
# $2, which prepare_dir has checked. It links files one by one, not a whole
# directory, as for skills: a harness writes its own files beside them. Hidden
# files, backups (*~), tests (test_*) and __pycache__ stay in the repo.
link_tree() {
    local source target
    for source in "$1"/*; do
        target="$2/${source##*/}"
        case "${source##*/}" in
            *~ | test_* | __pycache__) continue ;;
        esac
        if [[ -d "$source" ]]; then
            if check_source_dir "$source" && prepare_dir "$target"; then
                link_tree "$source" "$target"
            fi
        elif check_source_file "$source"; then
            make_link "$source" "$target"
        fi
    done
}

# Codex and OpenCode cannot read Claude Code's subagent format, so install
# writes their subagents from the sources ($4 and on) with
# tools/convert-agent.py. A comment in the first two lines says the file was
# generated, and from what.
generate_agents() {
    local dir="$1/agents"
    local format="$2"
    local extension="$3"
    local python=yes
    local agent name target content existing existing_source
    shift 3
    prepare_dir "$dir" || return 0
    # Python is needed only when there is a subagent to convert.
    if [[ $# -gt 0 ]] && ! command -v python3 >/dev/null; then
        report "python3 not found; it is needed to write the $format subagents"
        python=""
    fi
    for agent in "$@"; do
        name="${agent##*/}"
        target="$dir/${name%.md}.$extension"
        if [[ -e "$target" || -L "$target" ]]; then
            if ! existing_source="$(generated_source "$target")"; then
                report "$target: could not read its generated-file comment"
                continue
            fi
            if [[ "$existing_source" != "$agent" ]]; then
                report "$target: exists and was not generated from $agent"
                continue
            fi
        fi
        [[ -n "$python" ]] || continue
        if ! content="$(python3 "$HOUSE/tools/convert-agent.py" "$format" "$agent" \
            "${GENERATED_PREFIX}${agent}${GENERATED_SUFFIX}")"; then
            report "$agent: could not convert it for $format"
            continue
        fi
        existing=""
        if [[ -e "$target" ]] && ! existing="$(cat "$target")"; then
            report "$target: could not read it"
            continue
        fi
        if [[ "$content" != "$existing" ]] && write_file "$target" "$content"; then
            echo "wrote $target"
        fi
    done
    # A temporary file that a write left, when it was stopped.
    for target in "$dir"/.agent-house.*; do
        report "$target: a temporary file from an earlier run that was stopped"
    done
    # A generated file whose source is gone.
    for target in "$dir"/*."$extension"; do
        if ! agent="$(generated_source "$target")"; then
            report "$target: could not read its generated-file comment"
            continue
        fi
        if [[ "$agent" == "$USER_DIR/agents/"* && ! -e "$agent" ]]; then
            report "$target: generated from $agent, which no longer exists"
        fi
    done
}

# Everything that goes in the harness's own directory. $2 is the validated
# instruction source, or empty to skip it. Shared skills are installed later.
install_harness() {
    local harness="$1"
    local instructions_source="$2"
    local dir
    dir="$(harness_dir "$harness")"
    prepare_dir "$dir" || return 0

    if [[ -n "$instructions_source" ]]; then
        make_link "$instructions_source" "$dir/$(instructions_name "$harness")"
    fi
    case "$harness" in
        codex) generate_agents "$dir" codex toml ${agents[@]+"${agents[@]}"} ;;
        opencode) generate_agents "$dir" opencode md ${agents[@]+"${agents[@]}"} ;;
        *) link_each "$dir/agents" ${agents[@]+"${agents[@]}"} ;;
    esac
    # The files for this harness only (docs/harnesses.md). A harness can have
    # none.
    if [[ -e "$USER_DIR/$harness" || -L "$USER_DIR/$harness" ]] &&
        check_source_dir "$USER_DIR/$harness"; then
        link_tree "$USER_DIR/$harness" "$dir"
    fi
    if [[ "$harness" == claude ]]; then
        link_each "$dir/skills" ${skills[@]+"${skills[@]}"}
        if [[ -e "$dir/AGENTS.md" || -L "$dir/AGENTS.md" ]]; then
            report "$dir/AGENTS.md: Claude Code reads it only as a project file of an ancestor directory, so with CLAUDE.md it can load twice (docs/harnesses.md)"
        fi
    else
        check_links "$dir/skills" old-skills
    fi
}

# Each name is checked to be one harness, so the list splits safely on spaces.
harnesses=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --harness)
            [[ $# -ge 2 ]] || usage
            if ! is_harness "$2"; then
                echo "unknown harness: $2" >&2
                usage
            fi
            harnesses="$harnesses $2"
            shift 2
            ;;
        *) usage ;;
    esac
done

# The sources in user/, each checked once, before the harnesses that use them.
instructions_source=""
if check_source_file "$USER_DIR/AGENTS.md"; then
    instructions_source="$USER_DIR/AGENTS.md"
fi
skills=()
if check_source_dir "$USER_DIR/skills"; then
    for source in "$USER_DIR"/skills/*; do
        [[ "$source" == *~ ]] && continue
        if [[ ! -f "$source/SKILL.md" ]]; then
            report "$source: not a skill directory (no SKILL.md)"
        elif check_source_file "$source/SKILL.md"; then
            skills+=("$source")
        fi
    done
fi
agents=()
if check_source_dir "$USER_DIR/agents"; then
    for source in "$USER_DIR"/agents/*; do
        [[ "$source" == *~ ]] && continue
        if [[ "$source" != *.md ]]; then
            report "$source: not a subagent file (*.md)"
        elif check_source_file "$source"; then
            agents+=("$source")
        fi
    done
fi

shared_skills=""
for harness in ${harnesses:-$ALL_HARNESSES}; do
    install_harness "$harness" "$instructions_source"
    [[ "$harness" == claude ]] || shared_skills=yes
done
if [[ -n "$shared_skills" ]]; then
    link_each "$SHARED_SKILLS_DIR" ${skills[@]+"${skills[@]}"}
fi

if [[ $problems -gt 0 ]]; then
    echo "agent-house install: $problems problem(s); nothing was removed or replaced. Look into each one, then run install again." >&2
    exit 1
fi
