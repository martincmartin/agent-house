{
  // The mod API's types are in .claude-plugin/types/, which the engine writes
  // when a session loads the mod. In a checkout that no session loaded,
  // tools/check uses those of the main checkout (docs/status-band.md).
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "typeRoots": ["./.claude-plugin/types"],
    "types": ["claude-code", "claude-code-tools", "claude-code-mcp"]
  },
  "include": ["hooks", "types", "tests"]
}
